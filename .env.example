DATABASE_URL=postgresql+asyncpg://prm:prm@localhost:5433/prm
DATABASE_ECHO=false
JWT_SECRET=change-me-in-production-use-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
API_BASE_URL=http://localhost:8000
SCHEDULER_ENABLED=true
# Production (Phase 16)
CORS_ORIGINS=
LOG_FORMAT=text
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_AI_PER_MINUTE=20

# AI / LLM (skill match, team builder, risk summary, at-risk emails)
# LLM_PROVIDER: GEMINI or GROQ
LLM_PROVIDER=
LLM_API_KEY=
# Optional model overrides (defaults: gemini-2.0-flash, llama-3.3-70b-versatile)
GEMINI_MODEL=
GROQ_MODEL=
